# ClaudeClaw environment reference
#
# Start with `npm run setup`. The wizard writes the required values and safe
# defaults. Uncomment optional settings only when you need them.

# ==============================================================================
# Required
# ==============================================================================

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Your Telegram chat ID. Start the bot, send /chatid, then paste the result.
ALLOWED_CHAT_ID=

# ==============================================================================
# Identity, configuration, and storage
# ==============================================================================

# Personal configuration lives outside the repository.
# Default: ~/.claudeclaw
#
# macOS/Linux: leave ~ unquoted if a shell will source this file.
# CLAUDECLAW_CONFIG=~/.claudeclaw
#
# Windows: single-quote native paths so shells preserve every backslash.
# Existing unquoted Windows paths are corrected by `npm run migrate`.
# CLAUDECLAW_CONFIG='C:\Users\you\.claudeclaw'

# Deterministic owner label for shared surfaces such as text War Room.
# Setup fills this from its existing "Your name" question.
CLAUDECLAW_OWNER_NAME=User

# Override runtime data storage. Defaults to <repository>/store.
# CLAUDECLAW_STORE_DIR=

# SQLCipher key. Setup generates this automatically.
# Generate manually:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_ENCRYPTION_KEY=

# ==============================================================================
# Providers and authentication
# ==============================================================================

## Claude

# Uses `claude login` by default. Set an API key for pay-per-token billing.
ANTHROPIC_API_KEY=

# Optional account override.
# CLAUDE_CODE_OAUTH_TOKEN=

# Model IDs behind the Telegram /model opus|sonnet|haiku shortcuts.
# CLAUDE_MODEL_OPUS=claude-opus-4-8
# CLAUDE_MODEL_SONNET=claude-sonnet-4-6
# CLAUDE_MODEL_HAIKU=claude-haiku-4-5
# DEFAULT_CLAUDE_MODEL=

## Native OpenAI / Codex

# Native OpenAI is a stable provider and does not require ENABLE_ACP.
# Authenticate with either `codex login` or a scoped API key.
# API-key auth is recommended for bots exposed to untrusted input.
# OPENAI_API_KEY=

# Default remains GPT-5.5 during burn-in.
# Also selectable: gpt-6-astra (when enabled for the account), gpt-5.6-sol,
# gpt-5.6-terra, gpt-5.6-luna
# OPENAI_MODEL=gpt-5.5

# Transport:
#   sdk         default and rollback; one codex exec process per turn
#   app-server  opt-in warm persistent process with incremental text, scoped
#               cancellation, compaction telemetry, and policy verification
# CODEX_TRANSPORT=sdk

# Maximum concurrent App Server turns per agent process. Same-thread turns
# always serialize. Default: 8.
# CODEX_APP_SERVER_MAX_CONCURRENT_TURNS=8

# Trusted write escape hatch. Default: false.
#
# Leave this false for contained workspace-write access when the App Server
# transport is enabled and its platform gate is healthy.
#
# Setting this true gives eligible write turns danger-full-access, including unrestricted
# machine and network access. Use only for trusted private agents.
# CODEX_DANGER_WRITE=false

# Optional pricing overrides, per one million tokens.
# OPENAI_PRICING_JSON={"gpt-5.5":{"inputPerM":5,"cachedInputPerM":0.5,"outputPerM":30}}

# Compatibility override for deployments that must supply a model context
# capacity explicitly. ClaudeClaw should use live App Server telemetry when
# available rather than treating cumulative token usage as current occupancy.
# OPENAI_CONTEXT_WINDOW=

## Experimental alternate providers

# Enables experimental ACP providers such as OpenCode, Gemini CLI, Codex ACP,
# and custom ACP. It does not gate native OpenAI.
# ENABLE_ACP=false

# Native OpenRouter provider. Chat-only and independent of Codex.
# Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=z-ai/glm-4.5-air:free

# Z.ai GLM provider. Runs the SAME Claude Code subprocess as the Claude
# provider, pointed at z.ai's Anthropic-compatible endpoint — so GLM gets the
# full tool surface, unlike ClaudeClaw's current OpenRouter integration, which
# is chat-only. Other Anthropic-compatible endpoints are advanced configuration
# (see the two switches below).
#
# Exactly ONE key name may be set. ANTHROPIC_COMPAT_API_KEY and GLM_API_KEY are also read,
# but setting two at once is a configuration error and aborts, so a forgotten
# old value can never quietly win. Do NOT quote the value: the quotes travel
# into the Authorization header and produce a hintless HTTP 401.
# ZAI_API_KEY=

# The model, in all four slots the CLI knows. The [1m] suffix declares the real
# context window; without it Claude Code assumes 200k and compacts far too early.
# ANTHROPIC_COMPAT_MODEL=glm-5.3[1m]
# ANTHROPIC_COMPAT_FAST_MODEL=glm-4.7

# A different vendor needs BOTH of these. A URL that fails either check aborts
# the turn — there is deliberately no fallback to the default, because falling
# back would send a key meant for one vendor to another. https only.
# ANTHROPIC_COMPAT_ALLOW_CUSTOM_ENDPOINTS=false
# ANTHROPIC_COMPAT_ALLOWED_HOSTS=api.moonshot.ai,api.deepseek.com

# Fleet dispatch (mission / schedule / hive) for third-party turns. Off by
# default. Even when enabled, hive_read stays withheld: it would egress
# everything every agent has written to the shared mind.
# ANTHROPIC_COMPAT_ALLOW_DISPATCH=false

# Kill switch, read before every turn — no service restart needed. Set to false
# to make all nine agents refuse new anthropic-compatible turns at once.
# ANTHROPIC_COMPAT_ENABLED=true

# ==============================================================================
# Runtime behavior
# ==============================================================================

# Progressive in-place response updates for every provider.
# Options: global-throttle (default) | off
# STREAM_STRATEGY=global-throttle

# Hard limit for one interactive agent turn.
# Default: 900000 ms (15 minutes).
# AGENT_TIMEOUT_MS=900000
# Sliding provider-inactivity timeout (falls back to AGENT_TIMEOUT_MS for compatibility)
# AGENT_IDLE_TIMEOUT_MS=900000
# Absolute ceiling that never resets on activity
# AGENT_MAX_RUNTIME_MS=3600000
# Sliding provider-inactivity timeout for mission tasks and scheduled jobs
# SCHEDULER_IDLE_TIMEOUT_MS=900000
# Absolute ceiling for mission tasks and scheduled jobs
# SCHEDULER_MAX_RUNTIME_MS=1800000

# Maximum Claude SDK turns where supported. Default: 30.
# AGENT_MAX_TURNS=30

# Claude context capacity override. Default: 1000000.
# CONTEXT_LIMIT=1000000

# Optional Claude model fallback chain, comma-separated.
# MODEL_FALLBACK_CHAIN=

# Route simple Claude acknowledgements to a cheaper model.
# SMART_ROUTING_ENABLED=false
# SMART_ROUTING_CHEAP_MODEL=claude-haiku-4-5

# Cost footer. Options: compact (default) | full | off
# SHOW_COST_FOOTER=compact

# Cost/rate warnings for pay-per-use API billing.
# DAILY_COST_BUDGET=10.00
# HOURLY_TOKEN_BUDGET=500000

# ==============================================================================
# Memory and cross-agent coordination
# ==============================================================================

# Default isolated recall keeps each agent's memories separate while retaining
# the shared tier. Set shared only to preserve legacy cross-agent recall.
# MEMORY_RECALL_MODE=shared

# High-importance memory notification. Default: on.
# MEMORY_NOTIFY=off

# Reminder cadence for agents to persist durable context.
# Defaults: 10 turns or 2 hours, whichever comes first.
# MEMORY_NUDGE_INTERVAL_TURNS=10
# MEMORY_NUDGE_INTERVAL_HOURS=2

# Non-Claude shared Hive Mind reads are withheld by default because returned
# content leaves for that provider. Mission, schedule, and hive-log operations
# remain available according to caller authorization.
# DISPATCH_ALLOW_HIVE_READ=false

# ==============================================================================
# Security and process controls
# ==============================================================================

# Setup normally generates the PIN hash.
# SECURITY_PIN_HASH=

# Auto-lock after N idle minutes. Requires SECURITY_PIN_HASH. 0 disables it.
# IDLE_LOCK_MINUTES=30

# Sending this phrase immediately stops every ClaudeClaw service.
# EMERGENCY_KILL_PHRASE=

# Outbound secret-pattern redaction. Default: true.
# EXFILTRATION_GUARD_ENABLED=true

# Additional comma-separated environment-variable names to protect.
# PROTECTED_ENV_VARS=

# Dashboard emergency read-only switch. Default: true.
# DASHBOARD_MUTATIONS_ENABLED=true

# OAuth expiry alerts. Off by default.
# OAUTH_HEALTH_ENABLED=true
# OAUTH_CHECK_MINUTES=30
# OAUTH_ALERT_HOURS=2

# ==============================================================================
# Dashboard and messaging
# ==============================================================================

# Generate:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DASHBOARD_TOKEN=
# DASHBOARD_PORT=3141
# DASHBOARD_BIND=127.0.0.1
# DASHBOARD_URL=

# WhatsApp requires scripts/wa-daemon.ts.
# WHATSAPP_ENABLED=true

# Slack user OAuth token, beginning with xoxp-.
SLACK_USER_TOKEN=

# Signal alternative messenger. See docs/messengers/signal.md.
# MESSENGER_TYPE=telegram
# SIGNAL_PHONE_NUMBER=+490000000000
# SIGNAL_RPC_HOST=127.0.0.1
# SIGNAL_RPC_PORT=7583
# SIGNAL_AUTHORIZED_RECIPIENTS=+490000000000

# ==============================================================================
# Google and content integrations
# ==============================================================================

# Google AI Studio key for Gemini-backed video analysis and related skills.
GOOGLE_API_KEY=

# Google OAuth files used by Gmail and Calendar integrations.
GOOGLE_CREDS_PATH=~/.config/gmail/credentials.json
GMAIL_TOKEN_PATH=~/.config/gmail/token.json
GCAL_TOKEN_PATH=~/.config/calendar/token.json

# ==============================================================================
# Voice, meetings, and War Room
# ==============================================================================

# Voice and War Room voice mode are experimental. Their Python environment path
# is deferred from the v1.8.0 release gate. Text War Room is validated.

## Speech recognition

# Groq Whisper.
GROQ_API_KEY=

# Local whisper-cpp fallback.
# WHISPER_CPP_PATH=whisper-cpp
# WHISPER_MODEL_PATH=/opt/homebrew/share/whisper-cpp/models/ggml-small.bin

## Text-to-speech

# ElevenLabs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Gradium.
GRADIUM_API_KEY=
GRADIUM_VOICE_ID=

# Local OpenAI-compatible Kokoro server.
# KOKORO_URL=http://localhost:8880
# KOKORO_VOICE=af_heart
# KOKORO_MODEL=kokoro

# macOS local voice fallback. Requires ffmpeg.
# TTS_VOICE=Thomas

## War Room

# Text War Room and voice-mode feature switches.
# WARROOM_ENABLED=true
# WARROOM_TEXT_ENABLED=true
# WARROOM_VOICE_ENABLED=false
# WARROOM_PORT=7860

# Voice mode:
#   live    Gemini native audio
#   legacy  Deepgram + Cartesia
# WARROOM_MODE=live
# WARROOM_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
# WARROOM_LIVE_VOICE=

# Legacy voice mode only.
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=

## Video and voice meeting bots

# Pika video-meeting avatar.
# PIKA_DEV_KEY=dk_your-developer-key-here

# Recall.ai voice-only meeting bot.
# RECALL_API_KEY=
# RECALL_REGION=us-west-2

# Daily.co real-time avatar integration.
# DAILY_API_KEY=
# DAILY_API_BASE_URL=

# Maximum seconds allowed to prepare a meeting brief. Default: 75.
# MEET_BRIEF_TIMEOUT=75

# ==============================================================================
# Advanced operations
# ==============================================================================

# Logging.
# LOG_LEVEL=info
# LOG_PRETTY=true

# Personal vault bunker overrides.
# BUNKER_DIR=
# BUNKER_ARCHIVE_DIR=
# BUNKER_VAULT_DIR=
# BUNKER_EXPIRE_DAYS=

# ── Mattermost messenger (MESSENGER_TYPE=mattermost) ──
# See docs/mattermost.md for the full setup guide.
MESSENGER_TYPE=telegram
MATTERMOST_URL=https://chat.example.com         # no trailing slash
MATTERMOST_TOKEN=<bot-access-token>
MATTERMOST_TEAM=my-team # REQUIRED — the gateway serves exactly one team (slug or 26-char id, resolved at boot)
MATTERMOST_DEFAULT_AGENT=main
# Parse-safe defaults. Replace them with real 26-character channel IDs after
# copying this file; see docs/mattermost.md for examples.
MATTERMOST_CHANNEL_AGENT_MAP={}
MATTERMOST_MENTION_ONLY_CHANNELS=
# The ONE Mattermost user allowed to invoke ClaudeClaw (username or 26-char
# user ID). Fail-closed: the gateway refuses to boot without it. Everyone
# else is rejected before routing, state access, attachments, or commands.
MATTERMOST_OWNER_USER=your-mattermost-username
# Inbound attachment bounds (Vision): count, size in MB, allowed extensions.
MATTERMOST_MAX_FILES=4
MATTERMOST_MAX_FILE_MB=10
MATTERMOST_ALLOWED_FILE_TYPES=png,jpg,jpeg,webp,gif,pdf,txt,md,csv,json,docx,xlsx,pptx

# Opt-in Telegram /steer for Codex App Server and native Claude SDK turns.
MIDTURN_STEERING_ENABLED=false
